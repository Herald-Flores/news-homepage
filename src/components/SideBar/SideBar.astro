---
import Card from './Components/Card.astro'

import posts from '@/data/posts.json'

const data = posts.slice(3, 6)

---

<aside class="box-border col-span-1 order-2 mt-5 lg:mt-0 px-4 lg:px-0 lg:col-span-3 lg:row-span-5 lg:col-start-8">
	<div class="bg-neutral-dark dark:bg-neutral-white px-5 lg:px-5 py-4 lg:py-7">
		<h2 class="text-primary font-bold text-4xl mb-3 lg:mb-5">New</h2>
		<ul class="m-0 p-0 flex flex-col gap-6 divide-y">
			{
				data.map(card => (
					<Card
						id={card.id}
						title={card.title}
						body={card.excerpt}
					/>
				))
			}
		</ul>
	</div>
</aside>
